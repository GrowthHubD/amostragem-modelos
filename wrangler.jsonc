{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amostragem-modelos",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // URL publica do projeto Supabase (a mesma do front-end; nao e segredo)
    "SUPABASE_URL": "https://buiwcxygokdbmsdhquee.supabase.co"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Recarregar /admin, /login ou /<agente> direto na URL cai no index.html (SPA)
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_BUFFER",
        "class_name": "ChatBuffer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-chat-buffer",
      // new_sqlite_classes (nao new_classes): DOs com SQLite rodam no plano free
      "new_sqlite_classes": ["ChatBuffer"]
    }
  ]
}
