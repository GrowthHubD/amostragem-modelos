{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amostragem-modelos",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // URL publica do projeto Supabase (a mesma do front-end; nao e segredo)
    "SUPABASE_URL": "https://buiwcxygokdbmsdhquee.supabase.co",
    // Origin publico do Worker — usado pelo WaPoller para montar URLs das fotos
    // dos catalogos (o alarm nao tem request, entao nao da pra derivar do origin)
    "PUBLIC_ORIGIN": "https://amostragem-modelos.method-growth-hub.workers.dev"
  },
  "triggers": {
    // Watchdog do WaPoller (ver src/whatsapp.js): rearma o alarm apos deploys
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Recarregar /admin, /login ou /<agente> direto na URL cai no index.html (SPA)
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_BUFFER",
        "class_name": "ChatBuffer"
      },
      {
        "name": "WA_POLLER",
        "class_name": "WaPoller"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-chat-buffer",
      // new_sqlite_classes (nao new_classes): DOs com SQLite rodam no plano free
      "new_sqlite_classes": ["ChatBuffer"]
    },
    {
      "tag": "v2-wa-poller",
      "new_sqlite_classes": ["WaPoller"]
    }
  ]
}
